# Copy to terraform.tfvars (gitignored) and fill in the secrets, OR supply via environment:
#   export TF_VAR_oauth_shared_client_secret=...
#   export TF_VAR_auth0_rollback_client_secret=...
#   export TF_VAR_staging_oauth_shared_client_secret=...
#   export TF_VAR_teams_webhook_url=...
#
# All non-secret values have sensible defaults in variables.tf.
#
# `oauth_shared_client_secret` and `staging_oauth_shared_client_secret` now hold the SAME value — both
# targets run the one Entra app registration (staging since 2026-09-03, production since 2026-09-16).
# They stay separate variables only until #102 collapses them.
#
# `auth0_rollback_client_secret` is a THIRD, different value: the retained Auth0 client secret, still
# on the production Container App so a rollback needs no Key Vault window. Terraform consumes it to
# populate that secret, so it must be supplied; what does not reference it is the running app, whose
# OAuth__SharedClientSecret points at `entra-oauth-client-secret`. It goes when Auth0 is retired.

oauth_shared_client_secret         = "<Entra app client secret, Key Vault 'entra-mcp-client-secret' — PRODUCTION>"
auth0_rollback_client_secret       = "<retained Auth0 client secret — PRODUCTION rollback only>"
staging_oauth_shared_client_secret = "<Entra app client secret, Key Vault 'entra-mcp-client-secret' — STAGING>"
teams_webhook_url                  = "<Teams Power Automate Workflows webhook URL>"
